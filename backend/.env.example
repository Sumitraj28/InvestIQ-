# Server Configuration
PORT=5050
HOST=127.0.0.1

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb://127.0.0.1:27017/stocksense

# Python Data Service (FastAPI yfinance service)
PYTHON_DATA_SERVICE_URL=http://127.0.0.1:8000

# Clerk Authentication (JWT verification and session validation)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# AI Summary Service (OpenAI or Google Gemini)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Phase 4 Broker Token Encryption (AES-256-GCM)
ENCRYPTION_KEY=investiq-phase4-secure-broker-key-32b!

# Broker API Integrations (Official OAuth Developer Credentials)
ZERODHA_API_KEY=your_zerodha_api_key_here
ZERODHA_API_SECRET=your_zerodha_api_secret_here
ZERODHA_REDIRECT_URI=http://localhost:5050/api/brokers/zerodha/callback

UPSTOX_API_KEY=your_upstox_api_key_here
UPSTOX_API_SECRET=your_upstox_api_secret_here
UPSTOX_REDIRECT_URI=http://localhost:5050/api/brokers/upstox/callback

# Unsupported/Restricted in Retail OAuth (Documented in Feasibility Audit)
GROWW_API_KEY=your_groww_api_key_here
GROWW_API_SECRET=your_groww_api_secret_here
ANGELONE_API_KEY=your_angelone_api_key_here
